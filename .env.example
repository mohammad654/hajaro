# Copy to .env for local use. On your host, set these as environment variables instead.
# .env is git-ignored: never commit real credentials.

# Server
PORT=4000
# Number of proxies in front of the Node server (e.g. 1 behind a load balancer or Nginx). 0 = none.
TRUST_PROXY=0
# Hostnames the server answers to (comma separated), e.g. www.example.nl,example.nl
NG_ALLOWED_HOSTS=

# Contact form email (SMTP). Without SMTP_HOST, CONTACT_TO and CONTACT_FROM the form shows the
# email address instead of sending, and the server logs a warning.
SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Inbox that receives enquiries
CONTACT_TO=
# Sender address your SMTP provider allows, e.g. "Website <website@example.nl>"
CONTACT_FROM=
