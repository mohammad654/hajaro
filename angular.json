{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "963128af-39ea-4665-b53c-972e8723a286"
  },
  "newProjectRoot": "projects",
  "projects": {
    "hajaro": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "externalDependencies": ["fonts/*"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "*",
                "input": "images",
                "output": "images/home",
                "ignore": [
                  "*.pdf",
                  "Pasted*",
                  "Complete muscle group*",
                  "images (3).jpeg",
                  "images (4).jpeg",
                  "b0red-*",
                  "clker-*",
                  "davector-*",
                  "handsome-*",
                  "jensenartofficial-*",
                  "mcvec-*",
                  "mohamed_hassan-*",
                  "u_40rcbxqe6b-*"
                ]
              }
            ],
            "styles": ["src/styles.scss"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "src/server.ts"
            },
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles"]
            },
            "polyfills": ["@angular/localize/init"],
            "i18nMissingTranslation": "warning"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "localize": false
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            },
            "nl": {
              "localize": ["nl"]
            },
            "serve-en": {
              "localize": ["en"],
              "baseHref": "/en/"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "hajaro:build:production"
            },
            "development": {
              "buildTarget": "hajaro:build:development"
            },
            "en": {
              "buildTarget": "hajaro:build:development",
              "port": 4201
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "hajaro:build",
            "outputPath": "src/locale"
          }
        },
        "deploy": {
          "builder": "angular-cli-ghpages:deploy"
        }
      },
      "i18n": {
        "sourceLocale": {
          "code": "en",
          "subPath": "en"
        },
        "locales": {
          "nl": {
            "translation": "src/locale/messages.nl.xlf",
            "subPath": ""
          }
        }
      }
    }
  }
}
